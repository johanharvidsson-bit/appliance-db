---
import PageLayout from '~/layouts/PageLayout.astro'
import BreadcrumbNav from '~/components/BreadcrumbNav.astro'
import { supabase } from '~/lib/supabase'
import { siteConfig } from 'site-config'
import { t } from '~/lib/ui'

const locale = 'en'

export async function getStaticPaths() {
  const { data: brands } = await supabase
    .from('brands')
    .select('id, name, slug')
    .eq('is_active', true)

  return (brands ?? []).map((brand: any) => ({
    params: { brandSlug: brand.slug },
    props: { brandId: brand.id, brandName: brand.name },
  }))
}

const { brandSlug } = Astro.params as { brandSlug: string }
const { brandId, brandName } = Astro.props as { brandId: number; brandName: string }
const siteUrl = `https://${siteConfig.domain}`

// Get distinct categories this brand has error codes for
const { data: ecRows } = await supabase
  .from('error_codes')
  .select('category_id')
  .eq('brand_id', brandId)

const catIds = [...new Set((ecRows ?? []).map((e: any) => e.category_id).filter(Boolean))] as number[]

const { data: catData } = catIds.length > 0
  ? await supabase
      .from('category_translations')
      .select('category_id, slug, name')
      .in('category_id', catIds)
      .eq('locale', 'en')
  : { data: [] }

const categories = (catData ?? []).map((c: any) => ({ slug: c.slug, name: c.name }))
  .sort((a, b) => a.name.localeCompare(b.name))

const breadcrumbs = [
  { name: t(locale, 'nav.home'), url: `${siteUrl}/` },
  { name: t(locale, 'brandHub.allBrandsH1'), url: `${siteUrl}/brands/` },
  { name: brandName, url: `${siteUrl}/brands/${brandSlug}/` },
]

const alternateUrls = [
  { locale: 'en', url: `${siteUrl}/brands/${brandSlug}/` },
  { locale: 'sv', url: `${siteUrl}/sv/brands/${brandSlug}/` },
]
---

<PageLayout
  currentLocale={locale}
  alternateUrls={alternateUrls}
  metadata={{
    title: `${brandName} Faults and Error Codes | ${siteConfig.name}`,
    description: `Browse ${brandName} error codes and fault guides by appliance type. Free step-by-step repair guides.`,
    canonical: `${siteUrl}/brands/${brandSlug}/`,
    alternateUrls,
  }}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": t(locale, 'nav.home'), "item": siteUrl + "/" },
      { "@type": "ListItem", "position": 2, "name": t(locale, 'brandHub.allBrandsH1'), "item": siteUrl + "/brands/" },
      { "@type": "ListItem", "position": 3, "name": brandName, "item": siteUrl + "/brands/" + brandSlug + "/" },
    ],
  })} />

  <div class="page-container">
    <BreadcrumbNav items={breadcrumbs} />

    <h1 class="page-h1">{t(locale, 'brandHub.h1', { brand: brandName })}</h1>
    <p class="intro">{t(locale, 'brandHub.intro', { brand: brandName })}</p>

    {categories.length === 0 ? (
      <p class="no-data">{t(locale, 'brandHub.noGuides', { brand: brandName })}</p>
    ) : (
      <div class="appliance-grid">
        {categories.map(cat => (
          <a href={`/${cat.slug}/${brandSlug}/`} class="appliance-card">
            <span class="appliance-name">{cat.name}</span>
            <span class="appliance-arrow">→</span>
          </a>
        ))}
      </div>
    )}

    <div class="bottom-cta">
      <a href="/brands/" class="cta-link">{t(locale, 'brandHub.cta')}</a>
    </div>
  </div>
</PageLayout>

<style>
  .page-container {
    max-width: 40rem;
    margin: 0 auto;
    padding: 1.5rem 1rem 3rem;
  }
  .page-h1 {
    font-size: 1.875rem;
    font-weight: 800;
    color: #111827;
    margin: 0.5rem 0 0.5rem;
    line-height: 1.2;
  }
  .intro {
    color: #6b7280;
    margin: 0 0 2rem;
  }
  .no-data {
    color: #6b7280;
    padding: 2rem 0;
  }
  .appliance-grid {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .appliance-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    background: #f9fafb;
    text-decoration: none;
    color: #111827;
    font-weight: 600;
    transition: border-color 0.15s, background 0.15s, box-shadow 0.15s;
  }
  .appliance-card:hover {
    border-color: #2563eb;
    background: #eff6ff;
    box-shadow: 0 2px 8px rgba(37, 99, 235, 0.08);
  }
  .appliance-name {
    font-size: 1rem;
  }
  .appliance-arrow {
    color: #2563eb;
    font-size: 1.1rem;
    font-weight: 700;
  }
  .bottom-cta {
    border-top: 1px solid #e5e7eb;
    padding-top: 1.5rem;
    margin-top: 2rem;
  }
  .cta-link {
    font-size: 0.9rem;
    color: #6b7280;
    text-decoration: none;
  }
  .cta-link:hover {
    color: #2563eb;
    text-decoration: underline;
  }
</style>
