---
import { t } from '~/lib/ui'

interface Props {
  locale?: string
}
const { locale = 'en' } = Astro.props
---

<section class="spare-parts-section">
  <h2>{t(locale, 'spareParts.heading')}</h2>
  <p class="spare-parts-sub">{t(locale, 'spareParts.sub')}</p>

  <div class="spare-parts-grid">
    <div class="spare-parts-group">
      <h3>{t(locale, 'spareParts.partsHeading')}</h3>
      <ul>
        <li>
          <a href="https://www.appliancepartspros.com" target="_blank" rel="sponsored noopener noreferrer">
            AppliancePartsPros <span class="region">US</span>
          </a>
        </li>
        <li>
          <a href="https://www.espares.co.uk" target="_blank" rel="sponsored noopener noreferrer">
            eSpares <span class="region">UK</span>
          </a>
        </li>
        <li>
          <a href="https://www.fixpart.com" target="_blank" rel="sponsored noopener noreferrer">
            FixPart <span class="region">EU</span>
          </a>
        </li>
      </ul>
    </div>

    <div class="spare-parts-group">
      <h3>{t(locale, 'spareParts.repairHeading')}</h3>
      <ul>
        <li>
          <a href="https://www.taskrabbit.com" target="_blank" rel="sponsored noopener noreferrer">
            TaskRabbit
          </a>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  .spare-parts-section {
    margin: 2rem 0;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    padding: 1.25rem 1.5rem;
    background: #f9fafb;
  }
  .spare-parts-section h2 {
    font-size: 1.25rem;
    font-weight: 700;
    color: #111827;
    margin: 0 0 0.25rem;
  }
  .spare-parts-sub {
    font-size: 0.875rem;
    color: #6b7280;
    margin: 0 0 1.25rem;
  }
  .spare-parts-grid {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .spare-parts-group {
    flex: 1;
    min-width: 160px;
  }
  .spare-parts-group h3 {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #9ca3af;
    margin: 0 0 0.5rem;
  }
  .spare-parts-group ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .spare-parts-group a {
    font-size: 0.9rem;
    font-weight: 600;
    color: #2563eb;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .spare-parts-group a:hover {
    text-decoration: underline;
  }
  .region {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    background: #e5e7eb;
    color: #6b7280;
    border-radius: 4px;
    padding: 0.1rem 0.35rem;
  }
</style>
