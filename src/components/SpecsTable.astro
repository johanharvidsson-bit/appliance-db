---
import { t } from '~/lib/ui'

interface Props {
  specs: Record<string, any> | null
  locale?: string
}
const { specs, locale = 'en' } = Astro.props
if (!specs) return

const rows: { key: string; label: string; value: string }[] = []

if (specs.door_type != null) {
  const val = specs.door_type === 'front'
    ? t(locale, 'specs.frontLoad')
    : specs.door_type === 'top'
      ? t(locale, 'specs.topLoad')
      : specs.door_type
  rows.push({ key: 'door_type', label: t(locale, 'specs.doorType'), value: val })
}
if (specs.capacity_kg != null)
  rows.push({ key: 'capacity_kg', label: t(locale, 'specs.drumCapacity'), value: `${specs.capacity_kg} kg` })
if (specs.spin_speed_rpm != null)
  rows.push({ key: 'spin_speed_rpm', label: t(locale, 'specs.maxSpinSpeed'), value: `${specs.spin_speed_rpm} rpm` })
if (specs.energy_class != null)
  rows.push({ key: 'energy_class', label: t(locale, 'specs.energyClass'), value: specs.energy_class })
if (specs.width_mm != null)
  rows.push({ key: 'width_mm', label: t(locale, 'specs.width'), value: `${specs.width_mm} mm` })
if (specs.height_mm != null)
  rows.push({ key: 'height_mm', label: t(locale, 'specs.height'), value: `${specs.height_mm} mm` })
if (specs.depth_mm != null)
  rows.push({ key: 'depth_mm', label: t(locale, 'specs.depth'), value: `${specs.depth_mm} mm` })
if (specs.noise_spinning_db != null)
  rows.push({ key: 'noise_spinning_db', label: t(locale, 'specs.noiseSpin'), value: `${specs.noise_spinning_db} dB` })
if (specs.energy_consumption_kwh != null)
  rows.push({ key: 'energy_consumption_kwh', label: t(locale, 'specs.energyConsumption'), value: `${specs.energy_consumption_kwh} kWh` })
if (specs.water_consumption_l != null)
  rows.push({ key: 'water_consumption_l', label: t(locale, 'specs.waterConsumption'), value: `${specs.water_consumption_l} L` })

if (rows.length === 0) return
---

<dl class="specs-table">
  {rows.map(row => (
    <div class="specs-row">
      <dt class="specs-label">{row.label}</dt>
      <dd class="specs-value">{row.value}</dd>
    </div>
  ))}
</dl>

<style>
  .specs-table {
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    overflow: hidden;
    margin: 0;
  }
  .specs-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.6rem 1rem;
    border-bottom: 1px solid #f3f4f6;
  }
  .specs-row:last-child {
    border-bottom: none;
  }
  .specs-row:nth-child(even) {
    background: #f9fafb;
  }
  .specs-label {
    font-size: 0.875rem;
    color: #6b7280;
    font-weight: 500;
  }
  .specs-value {
    font-size: 0.875rem;
    font-weight: 600;
    color: #111827;
    text-align: right;
  }
</style>
