---
/** On-demand (SSR) — see EN counterpart's file-header comment for why. */
export const prerender = false

import PageLayout from '~/layouts/PageLayout.astro'
import BreadcrumbNav from '~/components/BreadcrumbNav.astro'
import { supabase } from '~/lib/supabase'
import { logged } from '~/lib/queries'
import { siteConfig } from 'site-config'
import { t } from '~/lib/ui'

Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=3600, stale-while-revalidate=86400')

const locale = 'sv'
const siteUrl = `https://${siteConfig.domain}`

const { data: brands } = await logged(
  supabase.from('brands').select('id, name, slug').eq('is_active', true).order('name'),
  'sv/brands/index'
)

const breadcrumbs = [
  { name: t(locale, 'nav.home'), url: `${siteUrl}/sv/` },
  { name: t(locale, 'brandHub.allBrandsH1'), url: `${siteUrl}/sv/brands/` },
]

const grouped = new Map<string, typeof brands>()
for (const brand of brands ?? []) {
  const letter = brand.name[0].toUpperCase()
  if (!grouped.has(letter)) grouped.set(letter, [])
  grouped.get(letter)!.push(brand)
}
const letters = [...grouped.keys()].sort()

const alternateUrls = [
  { locale: 'en', url: `${siteUrl}/brands/` },
  { locale: 'sv', url: `${siteUrl}/sv/brands/` },
]
---

<PageLayout
  currentLocale={locale}
  alternateUrls={alternateUrls}
  metadata={{
    title: `Alla apparatmärken – Felkoder & Reparationsguider | ${siteConfig.name}`,
    description: 'Bläddra bland reparationsguider och felkoder för alla stora apparatmärken. Hitta ditt märke för steg-för-steg-felsökning.',
    canonical: `${siteUrl}/sv/brands/`,
    alternateUrls,
  }}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": t(locale, 'nav.home'), "item": siteUrl + "/sv/" },
      { "@type": "ListItem", "position": 2, "name": t(locale, 'brandHub.allBrandsH1'), "item": siteUrl + "/sv/brands/" },
    ],
  })} />

  <div class="page-container">
    <BreadcrumbNav items={breadcrumbs} locale={locale} />

    <h1 class="page-h1">{t(locale, 'brandHub.allBrandsH1')}</h1>
    <p class="intro">{t(locale, 'brandHub.allBrandsIntro')}</p>

    {letters.map(letter => (
      <div class="letter-group">
        <div class="letter-heading">{letter}</div>
        <div class="brand-pills">
          {grouped.get(letter)!.map(brand => (
            <a href={`/sv/brands/${brand.slug}/`} class="brand-pill">
              {brand.name}
            </a>
          ))}
        </div>
      </div>
    ))}
  </div>
</PageLayout>

<style>
  .page-container {
    max-width: 48rem;
    margin: 0 auto;
    padding: 1.5rem 1rem 3rem;
  }
  .page-h1 {
    font-size: 1.875rem;
    font-weight: 800;
    color: #111827;
    margin: 0.5rem 0 0.5rem;
    line-height: 1.2;
  }
  .intro {
    color: #6b7280;
    margin: 0 0 2rem;
  }
  .letter-group {
    margin-bottom: 1.5rem;
  }
  .letter-heading {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #9ca3af;
    margin-bottom: 0.5rem;
  }
  .brand-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .brand-pill {
    display: inline-block;
    border: 1px solid #d1d5db;
    border-radius: 9999px;
    padding: 0.375rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: #374151;
    text-decoration: none;
    background: #fff;
    transition: background 0.15s, border-color 0.15s;
  }
  .brand-pill:hover {
    background: #f1f5f9;
    border-color: #9ca3af;
  }
</style>
