# ── Supabase ───────────────────────────────────────────────────────────────────
# Project URL — find it at: supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Service role key — find it at: supabase.com/dashboard/project/_/settings/api
# WARNING: keep this secret — it bypasses row-level security
SUPABASE_SERVICE_KEY=eyJhbGci...

# Legacy Supabase direct connection. Existing ApplianceRepairBase tooling may
# still use this while the new platform is introduced.
SUPABASE_DB_URL=

# ── RepairBase PostgreSQL on VPS ─────────────────────────────────────────────────
# Add sslmode=require when connecting over a network that is not private or tunneled.
DATABASE_URL=postgresql://repairbase_migrator:CHANGE_ME@127.0.0.1:5432/repairbase

# ── AI / LLM ──────────────────────────────────────────────────────────────────
# Anthropic API key — used by article_generator.py and enrich_error_codes.py
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ── External APIs ─────────────────────────────────────────────────────────────
# Serper (Google Search API) — used by enrich_error_codes.py
# https://serper.dev/api-key
SERPER_API_KEY=

# Scrape.do proxy API key — reserved for future bot-protected scraping targets
# Not used by any active pipeline script. Safe to leave blank.
# https://scrape.do
SCRAPE_DO_API_KEY=

# ── Scraper behaviour ─────────────────────────────────────────────────────────
# Seconds to wait between HTTP requests (default: 2.0)
REQUEST_DELAY_SECONDS=2.0

# Max retries on transient HTTP errors (default: 3)
MAX_RETRIES=3

# Download PDF manuals to disk for pdf_extractor (true/false)
DOWNLOAD_MANUALS=true

# Local directory for downloaded manuals (relative to project root)
MANUAL_DOWNLOAD_DIR=./data/manuals

# ── Tesseract OCR ─────────────────────────────────────────────────────────────
# Path to tesseract binary — required by image_extractor.py
# Windows default (install from: https://github.com/UB-Mannheim/tesseract/wiki)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux / macOS:
# TESSERACT_CMD=/usr/bin/tesseract

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=./logs
