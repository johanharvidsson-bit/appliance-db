---
interface Category {
  slug: string
  name: string
}

interface Props {
  categories: Category[]
  locale?: string
}

const { categories, locale = 'en' } = Astro.props

const emojiMap: Record<string, string> = {
  'washing-machines': '🫧',
  'dishwashers': '🍽️',
  'dryers': '🌀',
  'refrigerators': '❄️',
  'ovens': '🔥',
  'freezers': '🧊',
  'microwaves': '📡',
}
---

{categories && categories.length > 0 && (
  <section class="py-10 px-4">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-xl font-bold text-gray-900 mb-5">Browse by appliance type</h2>
      <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-7 gap-3">
        {categories.map(cat => (
          <a
            href={`/${cat.slug}/`}
            class="appliance-card flex flex-col items-center gap-2 bg-white border border-gray-200 rounded-xl p-3 text-center no-underline transition-all hover:-translate-y-0.5 hover:shadow-md hover:border-green-400"
          >
            <span class="text-2xl" aria-hidden="true">{emojiMap[cat.slug] ?? '🔧'}</span>
            <span class="text-xs font-semibold text-gray-700 leading-tight">{cat.name}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
)}
