---
import { buildSpecRows, type SpecField } from '~/lib/specs'

interface Props {
  specs: Record<string, any> | null
  fields: SpecField[]
  locale?: string
}
const { specs, fields, locale = 'en' } = Astro.props
if (!specs) return

const rows = buildSpecRows(specs, fields, locale)
if (rows.length === 0) return
---

<dl class="specs-table">
  {rows.map(row => (
    <div class="specs-row">
      <dt class="specs-label">{row.label}</dt>
      <dd class="specs-value">{row.value}</dd>
    </div>
  ))}
</dl>

<style>
  .specs-table {
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    overflow: hidden;
    margin: 0;
  }
  .specs-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.6rem 1rem;
    border-bottom: 1px solid #f3f4f6;
  }
  .specs-row:last-child {
    border-bottom: none;
  }
  .specs-row:nth-child(even) {
    background: #f9fafb;
  }
  .specs-label {
    font-size: 0.875rem;
    color: #6b7280;
    font-weight: 500;
  }
  .specs-value {
    font-size: 0.875rem;
    font-weight: 600;
    color: #111827;
    text-align: right;
  }
</style>
