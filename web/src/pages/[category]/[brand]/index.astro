---
/** On-demand (SSR) — see src/pages/[category]/[brand]/[slug]/index.astro for why. */
export const prerender = false

import PageLayout from '~/layouts/PageLayout.astro'
import BreadcrumbNav from '~/components/BreadcrumbNav.astro'
import SparePartsSection from '~/components/SparePartsSection.astro'
import { getCategoryBySlug, getBrandBySlug, getErrorCodesByBrandCategory, getModelsByBrandCategory, getCategoryAlternates, getFaultsByBrandCategoryLocale } from '~/lib/queries'
import { buildBrandUrl } from '~/lib/locales'
import { t, getSeverityBadges } from '~/lib/ui'
import { siteConfig } from 'site-config'

Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=3600, stale-while-revalidate=86400')

const { category, brand } = Astro.params as { category: string; brand: string }
const [{ data: categoryData }, { data: brandData }] = await Promise.all([
  getCategoryBySlug(category),
  getBrandBySlug(brand),
])
const categoryName = categoryData?.name ?? ''
const brandName = brandData?.name ?? ''
const siteUrl = `https://${siteConfig.domain}`
const categoryAlternates = categoryData?.category_id ? await getCategoryAlternates(categoryData.category_id) : []
const alternateUrls = categoryAlternates.map((alt: any) => ({
  locale: alt.locale,
  url: buildBrandUrl(siteUrl, alt.locale, alt.slug, brand),
}))

const [{ data: errorCodes }, { data: models }, { data: faults }] = await Promise.all([
  getErrorCodesByBrandCategory(brand, category),
  getModelsByBrandCategory(brand, category),
  getFaultsByBrandCategoryLocale('en', brand, category),
])
const hasFaults = faults && faults.length > 0

// Deduplicate models by series — one representative chip per series
const canonicalModels = (() => {
  const seen = new Map<string, any>()
  for (const m of (models ?? [])) {
    const key = m.series ?? m.name
    if (!seen.has(key)) seen.set(key, m)
  }
  return [...seen.values()].sort((a, b) => a.name.localeCompare(b.name))
})()

const categoryLabel = categoryName || category.replace(/-/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase())
const brandLabel = brandName || brand.replace(/-/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase())

const breadcrumbs = [
  { name: t('en', 'nav.home'), url: siteUrl + '/' },
  { name: categoryLabel, url: `${siteUrl}/${category}/` },
  { name: brandLabel, url: `${siteUrl}/${category}/${brand}/` },
]

const severityBadge = getSeverityBadges('en')
---

<PageLayout
  currentLocale="en"
  alternateUrls={alternateUrls}
  metadata={{
    title: `${t('en', 'meta.brandTitle', { brand: brandLabel, category: categoryLabel })} | ${siteConfig.name}`,
    description: t('en', 'meta.brandDesc', { brand: brandLabel, category: categoryLabel.toLowerCase() }),
    canonical: `${siteUrl}/${category}/${brand}/`,
    alternateUrls,
  }}
>
  <div class="page-container">
    <BreadcrumbNav items={breadcrumbs} locale="en" />

    <h1 class="page-h1">{t('en', 'brand.h1', { brand: brandLabel, category: categoryLabel })}</h1>
    <p class="intro">
      {t('en', 'brand.intro', { brand: brandLabel, category: categoryLabel.toLowerCase() })}
      {' '}<a href={`/brands/${brand}/`} class="hub-link">{t('en', 'brandHub.hubLink', { brand: brandLabel })}</a>
    </p>

    <!-- ── Table of contents ───────────────────────────────────── -->
    <nav class="toc" aria-label="Page contents">
      <ol class="toc-list">
        {hasFaults && <li><a href="#faults">{t('en', 'brand.faultsHeading')}</a></li>}
        <li><a href="#error-codes">{t('en', 'brand.errorCodesHeading')}</a></li>
        {models && models.length > 0 && <li><a href="#models">{t('en', 'brand.modelsHeading')}</a></li>}
        <li><a href="#spare-parts">{t('en', 'spareParts.heading')}</a></li>
      </ol>
    </nav>

    <!-- ── Section 1: Faults ───────────────────────────────────── -->
    {hasFaults && (
      <section id="faults" class="section">
        <h2 class="section-h2">{t('en', 'brand.faultsHeading')}</h2>
        <ul class="fault-list">
          {(faults ?? []).map((f: any) => {
            const ft = (f.fault_translations ?? [])[0]
            return ft?.symptom_name ? (
              <li>
                {f.article_slug
                  ? <a href={`/${category}/${brand}/problems/${f.article_slug}/`} class="fault-link">{ft.symptom_name}</a>
                  : <span class="fault-text">{ft.symptom_name}</span>
                }
              </li>
            ) : null
          })}
        </ul>
        <a href={`/${category}/${brand}/problems/`} class="view-all-link">
          {t('en', 'brand.faultsViewAll', { brand: brandLabel, category: categoryLabel.toLowerCase() })}
        </a>
      </section>
    )}

    <!-- ── Section 2: Error codes ──────────────────────────────── -->
    <section id="error-codes" class="section">
      <div class="section-header">
        <h2 class="section-h2">{t('en', 'brand.errorCodesHeading')} <span class="count">({errorCodes?.length ?? 0})</span></h2>
        <input
          id="ec-search"
          type="search"
          placeholder={t('en', 'brand.searchCodes')}
          class="search-input"
          autocomplete="off"
        />
      </div>

      {errorCodes && errorCodes.length > 0 ? (
        <>
          <div class="ec-jumps">
            {errorCodes.map((row: any) => (
              <a href={`#ec-${row.code?.toLowerCase()}`} class="ec-jump">{row.code}</a>
            ))}
          </div>
          <div class="ec-list" id="ec-grid">
          {errorCodes.map((row: any) => {
            const ats: any[] = row.articles?.article_translations ?? []
            const at = ats.find((t: any) => t.locale === 'en') ?? ats[0]
            const badge = row.severity ? (severityBadge[row.severity] ?? null) : null
            return (
              <article
                id={`ec-${row.code?.toLowerCase()}`}
                class="error-code"
                data-code={row.code?.toLowerCase()}
                data-text={row.short_description?.toLowerCase()}
              >
                <header class="error-header">
                  <span class="error-id">{row.code}</span>
                  {row.short_description
                    ? <h2 class="error-title">{row.short_description}</h2>
                    : <h2 class="error-title error-title--placeholder">{t('en', 'brand.titlePlaceholder')}</h2>
                  }
                  {badge
                    ? <span class={`severity ${badge.cls}`}>{badge.label}</span>
                    : <span class="severity severity--placeholder">—</span>
                  }
                </header>
                <p class="error-description">{row.description}</p>
                {at?.slug
                  ? <a class="error-link" href={`/${category}/${brand}/${at.slug}/`}>{t('en', 'brand.guideLink')}</a>
                  : <span class="error-link error-link--pending">{t('en', 'brand.guidePending')}</span>
                }
              </article>
            )
          })}
        </div>
        </>
      ) : (
        <p class="no-data">{t('en', 'brand.noResults')}</p>
      )}
    </section>

    <!-- ── Section 3: Models (always expanded) ─────────────────── -->
    {canonicalModels.length > 0 && (
      <section id="models" class="section">
        <div class="section-header">
          <h2 class="section-h2">{t('en', 'brand.modelsHeading')} <span class="count">({models?.length ?? 0})</span></h2>
          <input
            id="model-search"
            type="search"
            placeholder={t('en', 'brand.searchModels')}
            class="search-input"
            autocomplete="off"
          />
        </div>
        <p class="section-sub">{t('en', 'brand.modelsPanelSub')}</p>
        <div class="model-chips" id="model-grid">
          {canonicalModels.map((m: any) => (
            <a
              href={`/${category}/${brand}/${m.slug}/`}
              class="model-chip"
              data-name={m.name.toLowerCase()}
            >
              {m.name}
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- ── Section 4: Spare parts ──────────────────────────────── -->
    <div id="spare-parts">
      <SparePartsSection locale="en" />
    </div>
  </div>
</PageLayout>

<script>
  // Error code search
  const ecSearch = document.getElementById('ec-search') as HTMLInputElement | null
  ecSearch?.addEventListener('input', () => {
    const q = ecSearch.value.toLowerCase().trim()
    document.querySelectorAll<HTMLElement>('#ec-grid .error-code').forEach((card) => {
      const match = !q || card.dataset.code?.includes(q) || card.dataset.text?.includes(q)
      card.style.display = match ? '' : 'none'
    })
  })

  // Model search
  const modelSearch = document.getElementById('model-search') as HTMLInputElement | null
  modelSearch?.addEventListener('input', () => {
    const q = modelSearch.value.toLowerCase().trim()
    document.querySelectorAll<HTMLElement>('#model-grid .model-chip').forEach((chip) => {
      chip.style.display = !q || chip.dataset.name?.includes(q) ? '' : 'none'
    })
  })
</script>

<style>
  .page-container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 1.5rem 1rem 3rem;
  }
  .page-h1 {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 800;
    color: #111827;
    margin: 0 0 0.75rem;
  }
  .intro {
    color: #6b7280;
    margin-bottom: 1.5rem;
    line-height: 1.6;
  }

  /* Table of contents */
  .toc {
    margin-bottom: 2rem;
    padding: 0.875rem 1.125rem;
    background: #f9fafb;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
  }
  .toc-list {
    list-style: decimal;
    padding-left: 1.25rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .toc-list a {
    color: #2563eb;
    text-decoration: none;
    font-size: 0.9rem;
  }
  .toc-list a:hover { text-decoration: underline; }

  /* Fault list */
  .fault-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .fault-link, .fault-text {
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .fault-link {
    color: #2563eb;
    text-decoration: none;
  }
  .fault-link:hover { text-decoration: underline; }
  .fault-text { color: #6b7280; }

  .view-all-link {
    display: inline-block;
    font-size: 0.875rem;
    font-weight: 600;
    color: #2563eb;
    text-decoration: none;
  }
  .view-all-link:hover { text-decoration: underline; }

  /* Section anchors — offset for sticky nav */
  #faults, #error-codes, #models, #spare-parts {
    scroll-margin-top: 5rem;
  }

  /* Sections */
  .section {
    margin-bottom: 3rem;
  }
  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .section-h2 {
    font-size: 1.25rem;
    font-weight: 700;
    color: #111827;
    margin: 0;
  }
  .count {
    font-weight: 400;
    color: #9ca3af;
    font-size: 1rem;
  }
  .section-sub {
    font-size: 0.875rem;
    color: #6b7280;
    margin: -0.5rem 0 1rem;
  }
  .search-input {
    padding: 0.5rem 0.875rem;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    font-size: 0.9rem;
    color: #111827;
    outline: none;
    width: 200px;
  }
  .search-input:focus {
    border-color: #2563eb;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
  }

  /* ── Error code jump links ──────────────────────────────────────── */
  .ec-jumps {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
  }
  .ec-jump {
    display: inline-block;
    padding: 0.25rem 0.6rem;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    font-family: monospace;
    font-size: 0.8rem;
    font-weight: 600;
    color: #2563eb;
    text-decoration: none;
    background: #f9fafb;
    transition: border-color 0.1s, background 0.1s;
  }
  .ec-jump:hover {
    border-color: #2563eb;
    background: #eff6ff;
  }

  /* ── Error code two-row entries ─────────────────────────────────── */
  .ec-list {
    display: flex;
    flex-direction: column;
  }

  .error-code {
    border: 1.5px solid #e5e7eb;
    border-radius: 10px;
    padding: 1.125rem 1.375rem;
    margin-bottom: 1.375rem;
    background: #f8fafc;
    transition: border-color 0.15s, box-shadow 0.15s;
    scroll-margin-top: 5rem;
  }
  .error-code:hover {
    border-color: #cbd5e1;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.06);
  }

  /* Row 1 — three-column grid: code | title | badge */
  .error-header {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.625rem;
  }

  .error-id {
    font-family: monospace;
    font-size: 1.375rem;
    font-weight: 700;
    color: #111827;
    letter-spacing: 0.04em;
  }

  .error-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: #374151;
    margin: 0;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .error-title--placeholder {
    color: #d1d5db;
    font-weight: 400;
    font-style: italic;
  }

  @media (max-width: 600px) {
    .error-header {
      grid-template-columns: auto 1fr;
      grid-template-rows: auto auto;
    }
    .error-title {
      white-space: normal;
      text-overflow: unset;
      overflow: visible;
    }
    .severity { grid-row: 2; grid-column: 1; }
  }

  /* Severity badges */
  .severity {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .severity-easy     { background: #dcfce7; color: #15803d; }
  .severity-medium   { background: #fef9c3; color: #a16207; }
  .severity-advanced { background: #fee2e2; color: #b91c1c; }
  .severity--placeholder { background: none; color: #d1d5db; }

  .error-link {
    display: inline-block;
    margin-top: 0.625rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: #2563eb;
    text-decoration: none;
  }
  .error-link:hover { text-decoration: underline; }
  .error-link--pending {
    color: #d1d5db;
    font-weight: 400;
    font-style: italic;
    cursor: default;
  }

  /* Row 2 */
  .error-description {
    font-size: 0.875rem;
    color: #6b7280;
    margin: 0;
    line-height: 1.6;
  }

  /* Model chips */
  .model-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .model-chip {
    display: inline-block;
    padding: 0.3rem 0.75rem;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    font-size: 0.8rem;
    font-family: monospace;
    color: #374151;
    text-decoration: none;
    background: #f9fafb;
    transition: border-color 0.1s, background 0.1s, color 0.1s;
  }
  .model-chip:hover {
    border-color: #2563eb;
    background: #eff6ff;
    color: #1d4ed8;
  }

  .no-data {
    color: #6b7280;
    font-style: italic;
  }
  .hub-link {
    color: #2563eb;
    text-decoration: none;
    font-size: inherit;
  }
  .hub-link:hover { text-decoration: underline; }
</style>
