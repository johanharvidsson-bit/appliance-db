---
import { t } from '~/lib/ui'

interface Pill {
  name: string
  url: string
}

interface Props {
  pills: Pill[]
  locale?: string
}

const { pills, locale = 'en' } = Astro.props
---

{pills && pills.length > 0 && (
  <section class="py-10 px-4">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-xl font-bold text-gray-900 mb-1">{t(locale, 'home.commonFaults')}</h2>
      <p class="text-sm text-gray-500 mb-5">{t(locale, 'home.commonFaultsSub')}</p>
      <div class="flex flex-wrap gap-2">
        {pills.map(pill => (
          <a
            href={pill.url}
            class="rounded-full border border-gray-300 px-4 py-2 text-sm text-gray-700 hover:bg-slate-100 hover:border-gray-400 cursor-pointer transition-colors no-underline"
          >
            {pill.name}
          </a>
        ))}
      </div>
    </div>
  </section>
)}
