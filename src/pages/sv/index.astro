---
export const prerender = true
import PageLayout from '~/layouts/PageLayout.astro'
import { getCategoriesByLocale } from '~/lib/queries'
import { t } from '~/lib/ui'
import { siteConfig } from 'site-config'

const locale = 'sv'
const siteUrl = `https://${siteConfig.domain}`
const { data: categories } = await getCategoriesByLocale(locale)
---

<PageLayout
  currentLocale={locale}
  metadata={{
    title: `${siteConfig.name} – ${t(locale, 'meta.siteTagline')}`,
    description: t(locale, 'home.heroSub'),
    ignoreTitleTemplate: true,
    canonical: `${siteUrl}/${locale}/`,
    lang: locale,
  }}
>
  <section class="hero">
    <div class="hero-inner">
      <h1 class="hero-h1">{t(locale, 'home.heroH1')}</h1>
      <p class="hero-sub">
        {t(locale, 'home.heroSub')}
      </p>
    </div>
  </section>

  <section class="categories-section">
    <div class="section-inner">
      <h2 class="section-h2">{t(locale, 'home.browseByType')}</h2>
      {categories && categories.length > 0 ? (
        <div class="cat-grid">
          {categories.map((cat: any) => (
            <a href={`/${locale}/${cat.slug}/`} class="cat-card">
              <span class="cat-name">{cat.name}</span>
              <span class="cat-arrow">→</span>
            </a>
          ))}
        </div>
      ) : (
        <p class="no-data">{t(locale, 'home.noCategories')}</p>
      )}
    </div>
  </section>
</PageLayout>

<style>
  .hero { background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%); color: #fff; padding: 4rem 1rem 3.5rem; text-align: center; }
  .hero-inner { max-width: 700px; margin: 0 auto; }
  .hero-h1 { font-size: clamp(1.75rem, 4vw, 2.75rem); font-weight: 800; line-height: 1.2; margin: 0 0 1rem; }
  .hero-sub { font-size: 1.1rem; opacity: 0.9; line-height: 1.6; margin: 0; }
  .categories-section { padding: 3rem 1rem; }
  .section-inner { max-width: 900px; margin: 0 auto; }
  .section-h2 { font-size: 1.5rem; font-weight: 700; color: #111827; margin: 0 0 1.5rem; }
  .cat-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1rem; }
  .cat-card { display: flex; align-items: center; justify-content: space-between; padding: 1.25rem 1.5rem; border: 1px solid #e5e7eb; border-radius: 12px; text-decoration: none; color: #111827; font-weight: 600; transition: border-color 0.15s, box-shadow 0.15s; }
  .cat-card:hover { border-color: #2563eb; box-shadow: 0 0 0 3px rgba(37,99,235,0.1); color: #2563eb; }
  .cat-arrow { color: #9ca3af; }
  .no-data { color: #6b7280; font-style: italic; }
</style>
