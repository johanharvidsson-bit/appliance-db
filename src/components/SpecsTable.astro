---
interface Props {
  specs: Record<string, any> | null
  locale?: string
}
const { specs, locale = 'en' } = Astro.props
if (!specs) return

const rows: { key: string; label: string; format: (v: any) => string }[] = [
  { key: 'door_type',              label: 'Door type',           format: v => v === 'front' ? 'Front load' : v === 'top' ? 'Top load' : v },
  { key: 'capacity_kg',            label: 'Drum capacity',       format: v => `${v} kg` },
  { key: 'spin_speed_rpm',         label: 'Max spin speed',      format: v => `${v} rpm` },
  { key: 'energy_class',           label: 'Energy class',        format: v => v },
  { key: 'width_mm',               label: 'Width',               format: v => `${v} mm` },
  { key: 'height_mm',              label: 'Height',              format: v => `${v} mm` },
  { key: 'depth_mm',               label: 'Depth',               format: v => `${v} mm` },
  { key: 'noise_spinning_db',      label: 'Noise (spin)',        format: v => `${v} dB` },
  { key: 'energy_consumption_kwh', label: 'Energy consumption',  format: v => `${v} kWh` },
  { key: 'water_consumption_l',    label: 'Water consumption',   format: v => `${v} L` },
]

const visibleRows = rows.filter(r => specs[r.key] != null)
if (visibleRows.length === 0) return
---

<dl class="specs-table">
  {visibleRows.map(row => (
    <div class="specs-row">
      <dt class="specs-label">{row.label}</dt>
      <dd class="specs-value">{row.format(specs[row.key])}</dd>
    </div>
  ))}
</dl>

<style>
  .specs-table {
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    overflow: hidden;
    margin: 0;
  }
  .specs-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.6rem 1rem;
    border-bottom: 1px solid #f3f4f6;
  }
  .specs-row:last-child {
    border-bottom: none;
  }
  .specs-row:nth-child(even) {
    background: #f9fafb;
  }
  .specs-label {
    font-size: 0.875rem;
    color: #6b7280;
    font-weight: 500;
  }
  .specs-value {
    font-size: 0.875rem;
    font-weight: 600;
    color: #111827;
    text-align: right;
  }
</style>
