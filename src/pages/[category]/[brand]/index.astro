---
import PageLayout from '~/layouts/PageLayout.astro'
import BreadcrumbNav from '~/components/BreadcrumbNav.astro'
import { getCategories, getBrandsByCategory, getErrorCodesByBrandCategory, getModelsByBrandCategory, getCategoryAlternates, getFaultsByBrandCategoryLocale } from '~/lib/queries'
import { buildBrandUrl } from '~/lib/locales'
import { t } from '~/lib/ui'
import { siteConfig } from 'site-config'

export async function getStaticPaths() {
  const { data: categories } = await getCategories()
  if (!categories) return []

  const paths: any[] = []
  for (const cat of categories) {
    const [{ data: brands }, alternates] = await Promise.all([
      getBrandsByCategory(cat.slug),
      getCategoryAlternates(cat.category_id),
    ])
    if (!brands) continue
    for (const brand of brands) {
      paths.push({
        params: { category: cat.slug, brand: brand.slug },
        props: { categoryName: cat.name, brandName: brand.name, categoryAlternates: alternates },
      })
    }
  }
  return paths
}

const { category, brand } = Astro.params as { category: string; brand: string }
const { categoryName, brandName, categoryAlternates } = Astro.props as { categoryName: string; brandName: string; categoryAlternates: any[] }
const siteUrl = `https://${siteConfig.domain}`
const alternateUrls = (categoryAlternates ?? []).map((alt: any) => ({
  locale: alt.locale,
  url: buildBrandUrl(siteUrl, alt.locale, alt.slug, brand),
}))

const [{ data: errorCodes }, { data: models }, { data: faults }] = await Promise.all([
  getErrorCodesByBrandCategory(brand, category),
  getModelsByBrandCategory(brand, category),
  getFaultsByBrandCategoryLocale('en', brand, category),
])
const hasFaults = faults && faults.length > 0

const categoryLabel = categoryName || category.replace(/-/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase())
const brandLabel = brandName || brand.replace(/-/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase())

const breadcrumbs = [
  { name: t('en', 'nav.home'), url: siteUrl + '/' },
  { name: categoryLabel, url: `${siteUrl}/${category}/` },
  { name: brandLabel, url: `${siteUrl}/${category}/${brand}/` },
]

const severityBadge: Record<string, { cls: string; label: string }> = {
  easy:     { cls: 'severity-easy',     label: t('en', 'severity.easy') },
  medium:   { cls: 'severity-medium',   label: t('en', 'severity.medium') },
  advanced: { cls: 'severity-advanced', label: t('en', 'severity.advanced') },
}
---

<PageLayout
  currentLocale="en"
  alternateUrls={alternateUrls}
  metadata={{
    title: `${t('en', 'meta.brandTitle', { brand: brandLabel, category: categoryLabel })} | ${siteConfig.name}`,
    description: t('en', 'meta.brandDesc', { brand: brandLabel, category: categoryLabel.toLowerCase() }),
    canonical: `${siteUrl}/${category}/${brand}/`,
    alternateUrls,
  }}
>
  <div class="page-container">
    <BreadcrumbNav items={breadcrumbs} />

    <h1 class="page-h1">{t('en', 'brand.h1', { brand: brandLabel, category: categoryLabel })}</h1>
    <p class="intro">
      {t('en', 'brand.intro', { brand: brandLabel, category: categoryLabel.toLowerCase() })}
      {' '}<a href={`/brands/${brand}/`} class="hub-link">{t('en', 'brandHub.hubLink', { brand: brandLabel })}</a>
    </p>

    <!-- ── Common problems callout ─────────────────────────────── -->
    {hasFaults && (
      <a href={`/${category}/${brand}/problems/`} class="problems-callout">
        <span class="problems-callout-icon" aria-hidden="true">⚠</span>
        <span class="problems-callout-text">
          <strong>{t('en', 'brand.noErrorCodeCallout')}</strong> {t('en', 'brand.browseProblems', { brand: brandLabel, category: categoryLabel.toLowerCase() })}
        </span>
        <span class="problems-callout-arrow">→</span>
      </a>
    )}

    <!-- ── Section 1: Error codes ──────────────────────────────── -->
    <section class="section">
      <div class="section-header">
        <h2 class="section-h2">{t('en', 'brand.errorCodesHeading')} <span class="count">({errorCodes?.length ?? 0})</span></h2>
        <input
          id="ec-search"
          type="search"
          placeholder={t('en', 'brand.searchCodes')}
          class="search-input"
          autocomplete="off"
        />
      </div>

      {errorCodes && errorCodes.length > 0 ? (
        <>
          <div class="ec-jumps">
            {errorCodes.map((row: any) => (
              <a href={`#ec-${row.code?.toLowerCase()}`} class="ec-jump">{row.code}</a>
            ))}
          </div>
          <div class="ec-list" id="ec-grid">
          {errorCodes.map((row: any) => {
            const ats: any[] = row.articles?.article_translations ?? []
            const at = ats.find((t: any) => t.locale === 'en') ?? ats[0]
            const badge = row.severity ? (severityBadge[row.severity] ?? null) : null
            return (
              <article
                id={`ec-${row.code?.toLowerCase()}`}
                class="error-code"
                data-code={row.code?.toLowerCase()}
                data-text={row.short_description?.toLowerCase()}
              >
                <header class="error-header">
                  <span class="error-id">{row.code}</span>
                  {row.short_description
                    ? <h2 class="error-title">{row.short_description}</h2>
                    : <h2 class="error-title error-title--placeholder">{t('en', 'brand.titlePlaceholder')}</h2>
                  }
                  {badge
                    ? <span class={`severity ${badge.cls}`}>{badge.label}</span>
                    : <span class="severity severity--placeholder">—</span>
                  }
                </header>
                <p class="error-description">{row.description}</p>
                {at?.slug
                  ? <a class="error-link" href={`/${category}/${brand}/${at.slug}/`}>{t('en', 'brand.guideLink')}</a>
                  : <span class="error-link error-link--pending">{t('en', 'brand.guidePending')}</span>
                }
              </article>
            )
          })}
        </div>
        </>
      ) : (
        <p class="no-data">{t('en', 'brand.noResults')}</p>
      )}
    </section>

    <!-- ── Section 2: Models (collapsed by default) ─────────────── -->
    {models && models.length > 0 && (
      <section class="section">
        <button class="models-toggle" id="models-toggle" aria-expanded="false">
          {t('en', 'brand.browseModels', { brand: brandLabel, category: categoryLabel })}
          <svg class="toggle-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
          </svg>
        </button>

        <div class="models-panel" id="models-panel" hidden>
          <div class="models-panel-header">
            <p class="section-sub">{t('en', 'brand.modelsPanelSub')}</p>
            <input
              id="model-search"
              type="search"
              placeholder={t('en', 'brand.searchModels')}
              class="search-input"
              autocomplete="off"
            />
          </div>
          <div class="model-chips" id="model-grid">
            {models.map((m: any) => (
              <a
                href={`/${category}/${brand}/${m.slug}/`}
                class="model-chip"
                data-name={m.name.toLowerCase()}
              >
                {m.name}
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </div>
</PageLayout>

<script>
  // Error code search
  const ecSearch = document.getElementById('ec-search') as HTMLInputElement | null
  ecSearch?.addEventListener('input', () => {
    const q = ecSearch.value.toLowerCase().trim()
    document.querySelectorAll<HTMLElement>('#ec-grid .error-code').forEach((card) => {
      const match = !q || card.dataset.code?.includes(q) || card.dataset.text?.includes(q)
      card.style.display = match ? '' : 'none'
    })
  })

  // Models toggle
  const toggle = document.getElementById('models-toggle')
  const panel  = document.getElementById('models-panel')
  toggle?.addEventListener('click', () => {
    const open = panel?.hasAttribute('hidden')
    if (open) {
      panel?.removeAttribute('hidden')
      toggle.setAttribute('aria-expanded', 'true')
      toggle.classList.add('open')
    } else {
      panel?.setAttribute('hidden', '')
      toggle.setAttribute('aria-expanded', 'false')
      toggle.classList.remove('open')
    }
  })

  // Model search (only wired up once panel exists in DOM)
  const modelSearch = document.getElementById('model-search') as HTMLInputElement | null
  modelSearch?.addEventListener('input', () => {
    const q = modelSearch.value.toLowerCase().trim()
    document.querySelectorAll<HTMLElement>('#model-grid .model-chip').forEach((chip) => {
      chip.style.display = !q || chip.dataset.name?.includes(q) ? '' : 'none'
    })
  })
</script>

<style>
  .page-container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 1.5rem 1rem 3rem;
  }
  .page-h1 {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 800;
    color: #111827;
    margin: 0 0 0.75rem;
  }
  .intro {
    color: #6b7280;
    margin-bottom: 2rem;
    line-height: 1.6;
  }

  /* Common problems callout */
  .problems-callout {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 1.125rem;
    margin-bottom: 2rem;
    border: 1.5px solid #fcd34d;
    border-radius: 10px;
    background: #fffbeb;
    text-decoration: none;
    color: #111827;
    transition: border-color 0.15s, background 0.15s;
  }
  .problems-callout:hover {
    border-color: #f59e0b;
    background: #fef3c7;
  }
  .problems-callout-icon {
    font-size: 1.1rem;
    color: #d97706;
    flex-shrink: 0;
  }
  .problems-callout-text {
    flex: 1;
    font-size: 0.9rem;
    line-height: 1.4;
    color: #374151;
  }
  .problems-callout-text strong {
    color: #111827;
  }
  .problems-callout-arrow {
    font-size: 1rem;
    color: #d97706;
    flex-shrink: 0;
    font-weight: 700;
  }

  /* Sections */
  .section {
    margin-bottom: 3rem;
  }
  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .section-h2 {
    font-size: 1.25rem;
    font-weight: 700;
    color: #111827;
    margin: 0;
  }
  .count {
    font-weight: 400;
    color: #9ca3af;
    font-size: 1rem;
  }
  .section-sub {
    font-size: 0.875rem;
    color: #6b7280;
    margin: -0.5rem 0 1rem;
  }
  .search-input {
    padding: 0.5rem 0.875rem;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    font-size: 0.9rem;
    color: #111827;
    outline: none;
    width: 200px;
  }
  .search-input:focus {
    border-color: #2563eb;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
  }

  /* ── Error code jump links ──────────────────────────────────────── */
  .ec-jumps {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
  }
  .ec-jump {
    display: inline-block;
    padding: 0.25rem 0.6rem;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    font-family: monospace;
    font-size: 0.8rem;
    font-weight: 600;
    color: #2563eb;
    text-decoration: none;
    background: #f9fafb;
    transition: border-color 0.1s, background 0.1s;
  }
  .ec-jump:hover {
    border-color: #2563eb;
    background: #eff6ff;
  }

  /* ── Error code two-row entries ─────────────────────────────────── */
  .ec-list {
    display: flex;
    flex-direction: column;
  }

  .error-code {
    border: 1.5px solid #e5e7eb;
    border-radius: 10px;
    padding: 1.125rem 1.375rem;
    margin-bottom: 1.375rem;
    background: #f8fafc;
    transition: border-color 0.15s, box-shadow 0.15s;
    scroll-margin-top: 5rem;
  }
  .error-code:hover {
    border-color: #cbd5e1;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.06);
  }

  /* Row 1 — three-column grid: code | title | badge */
  .error-header {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.625rem;
  }

  .error-id {
    font-family: monospace;
    font-size: 1.375rem;
    font-weight: 700;
    color: #111827;
    letter-spacing: 0.04em;
  }

  .error-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: #374151;
    margin: 0;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .error-title--placeholder {
    color: #d1d5db;
    font-weight: 400;
    font-style: italic;
  }

  @media (max-width: 600px) {
    .error-header {
      grid-template-columns: auto 1fr;
      grid-template-rows: auto auto;
    }
    .error-title {
      white-space: normal;
      text-overflow: unset;
      overflow: visible;
    }
    .severity { grid-row: 2; grid-column: 1; }
  }

  /* Severity badges */
  .severity {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .severity-easy     { background: #dcfce7; color: #15803d; }
  .severity-medium   { background: #fef9c3; color: #a16207; }
  .severity-advanced { background: #fee2e2; color: #b91c1c; }
  .severity--placeholder { background: none; color: #d1d5db; }

  .error-link {
    display: inline-block;
    margin-top: 0.625rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: #2563eb;
    text-decoration: none;
  }
  .error-link:hover { text-decoration: underline; }
  .error-link--pending {
    color: #d1d5db;
    font-weight: 400;
    font-style: italic;
    cursor: default;
  }

  /* Row 2 */
  .error-description {
    font-size: 0.875rem;
    color: #6b7280;
    margin: 0;
    line-height: 1.6;
  }

  /* Models toggle button */
  .models-toggle {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.875rem 1.25rem;
    background: #f9fafb;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    font-size: 1rem;
    font-weight: 600;
    color: #111827;
    cursor: pointer;
    text-align: left;
    transition: background 0.15s, border-color 0.15s;
  }
  .models-toggle:hover {
    background: #eff6ff;
    border-color: #2563eb;
    color: #1d4ed8;
  }
  .toggle-icon {
    width: 1.25rem;
    height: 1.25rem;
    margin-left: auto;
    flex-shrink: 0;
    transition: transform 0.2s;
  }
  .models-toggle.open .toggle-icon {
    transform: rotate(180deg);
  }
  .models-panel {
    margin-top: 1rem;
  }
  .models-panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  /* Model chips */
  .model-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .model-chip {
    display: inline-block;
    padding: 0.3rem 0.75rem;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    font-size: 0.8rem;
    font-family: monospace;
    color: #374151;
    text-decoration: none;
    background: #f9fafb;
    transition: border-color 0.1s, background 0.1s, color 0.1s;
  }
  .model-chip:hover {
    border-color: #2563eb;
    background: #eff6ff;
    color: #1d4ed8;
  }

  .no-data {
    color: #6b7280;
    font-style: italic;
  }
  .hub-link {
    color: #2563eb;
    text-decoration: none;
    font-size: inherit;
  }
  .hub-link:hover { text-decoration: underline; }
</style>
